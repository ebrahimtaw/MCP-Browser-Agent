# ---- Backend (Render) ----
# Required. The agent returns 503 without it.
OPENAI_API_KEY=sk-...

# Comma-separated origins allowed to call the API. Must include your Vercel
# production URL or the browser blocks every request with a CORS error.
ALLOWED_ORIGINS=https://mcp-browser-agent-sigma.vercel.app

# Regex for the per-commit hostnames Vercel gives preview deployments.
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional tuning.
AGENT_RUN_TIMEOUT=240
AGENT_MAX_ITERATIONS=25
AGENT_MAX_TOKENS=8000

# ---- Frontend (Vercel) ----
# Baked in at build time, so changing it requires a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
